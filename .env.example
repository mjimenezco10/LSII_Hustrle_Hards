# Copy this file to .env (gitignored) and set your own values. docker compose reads .env automatically.
# Folder with the video store generated by tooling/videoGrabber (.mp4 / .webp / .json per video), ending with a
# separator. The same variable the backend uses outside Docker; if it is already set in your environment, that wins.
ENV_PROTUBE_STORE_DIR=C:/path/to/protube-videos/
# Optional: OAuth client id for "Sign in with Google" (see DEVELOPMENT.md). Only the backend needs it; empty hides the
# Google button.
ENV_PROTUBE_GOOGLE_CLIENT_ID=
# Optional: key that signs the session tokens (>= 32 characters). Keep it fixed so sessions survive restarts.
# ENV_PROTUBE_JWT_SECRET=
# Optional: host ports. The app is on http://localhost:8080 (frontend + routes to the backend).
# PROTUBE_FRONTEND_PORT=8080
# PROTUBE_BACKEND_PORT=8082
